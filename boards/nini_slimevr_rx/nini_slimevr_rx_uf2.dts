//
// nini_slimevr_5883rx_uf2.dts —— 接收端(receiver)板级设备树（nini 注入）。
// SoC nRF52833（nrf52833_qdaa.dtsi）。与旧板 nini_slimevr_uf2 的差异：
//   · 三色 LED 改【共阴】（高电平点亮）、引脚重排：绿 P0.30 / 蓝 P0.29 / 红 P0.28；
//     新板绿蓝焊对——不移植旧板 apply_pwm 对调补偿；
//   · FEM 换 AT2401C：compatible 只写通用绑定 radio-fem-two-ctrl-pins
//     （不写 skyworks 型号），ctx=P0.17 / crx=P0.15，增益按 AT2401C 起步 22/12 后调；
//   · reg1 改 DCDC（旧板为 LDO）；
//   · UICR 仅 nfct-pins-as-gpios（本板无 P0.18 nRESET 需求）。
// 按键：P0.3（上拉、低电平有效）。

/dts-v1/;
#include <nordic/nrf52833_qdaa.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>

&pinctrl {
	pwm0_default: pwm0_default {
		group1 {
			psels = <NRF_PSEL(PWM_OUT0, 0, 28)>, //red
				<NRF_PSEL(PWM_OUT1, 0, 30)>, //green
				<NRF_PSEL(PWM_OUT2, 0, 29)>; //blue
			nordic,drive-mode = <NRF_DRIVE_S0H1>;
		};
	};

	pwm0_sleep: pwm0_sleep {
		group1 {
			psels = <NRF_PSEL(PWM_OUT0, 0, 28)>, //red
				<NRF_PSEL(PWM_OUT1, 0, 30)>, //green
				<NRF_PSEL(PWM_OUT2, 0, 29)>; //blue
			low-power-enable;
		};
	};
};

/ {
	model = "NiNi SlimeVR nRF52833 Receiver";
	compatible = "nini_slimevr_rx_uf2";

	chosen {
		zephyr,console = &cdc_acm_uart;
		zephyr,shell-uart = &cdc_acm_uart;
		zephyr,uart-mcumgr = &cdc_acm_uart;
		zephyr,bt-mon-uart = &cdc_acm_uart;
		zephyr,bt-c2h-uart = &cdc_acm_uart;
		zephyr,sram = &sram0;
		zephyr,flash = &flash0;
		zephyr,ieee802154 = &ieee802154;
	};

	nrf_radio_fem: at2401cFem {
		// 射频前端 AT2401C：放大射频信号、增大通信距离。只挂通用双控制脚
		// 绑定（radio-fem-two-ctrl-pins），不冒用 skyworks 型号兼容。
		compatible = "radio-fem-two-ctrl-pins";
		ctx-gpios = <&gpio0 17 GPIO_ACTIVE_HIGH>;   // TX 控制脚 P0.17（高有效）
		ctx-settle-time-us = <2>;
		crx-gpios = <&gpio0 15 GPIO_ACTIVE_HIGH>;   // RX 控制脚 P0.15（高有效）
		crx-settle-time-us = <2>;
		tx-gain-db = <22>;   // AT2401C 起步值，上板按链路实测后调
		rx-gain-db = <12>;   // 同上
	};

	/* 三色 LED【共阴】封装（高电平点亮）。每脚同时挂 gpio-leds(led0/1/2，
	 * GPIO 直驱通断) 与 pwm-leds(pwm_led0/1/2，PWM 调亮/呼吸) 双别名：
	 * 稳态/纯闪烁走 GPIO 直驱 + PWM 外设挂起省电，呼吸/中间亮度走 PWM。
	 * 色序 led0=红 / led1=绿 / led2=蓝（led.c 三色约定）。 */
	leds {
		compatible = "gpio-leds";
		led0_red: led_0 {
			gpios = <&gpio0 28 GPIO_ACTIVE_HIGH>;   // 红灯 P0.28（共阴高电平点亮）
			label = "Red LED 0";
		};
		led0_green: led_1 {
			gpios = <&gpio0 30 GPIO_ACTIVE_HIGH>;   // 绿灯 P0.30
			label = "Green LED 0";
		};
		led0_blue: led_2 {
			gpios = <&gpio0 29 GPIO_ACTIVE_HIGH>;   // 蓝灯 P0.29
			label = "Blue LED 0";
		};
	};

	pwmleds {
		compatible = "pwm-leds";
		red_pwm_led: pwm_led_0 {
			pwms = <&pwm0 0 PWM_MSEC(1) PWM_POLARITY_NORMAL>;
		};
		green_pwm_led: pwm_led_1 {
			pwms = <&pwm0 1 PWM_MSEC(1) PWM_POLARITY_NORMAL>;
		};
		blue_pwm_led: pwm_led_2 {
			pwms = <&pwm0 2 PWM_MSEC(1) PWM_POLARITY_NORMAL>;
		};
	};

	buttons {
		compatible = "gpio-keys";
		button0: button_0 {
			gpios = <&gpio0 3 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;   // 按键 P0.3（内部上拉，按下拉低）
			label = "Push button switch 0";
			zephyr,code = <INPUT_KEY_0>;
		};
	};

	aliases {
		sw0 = &button0;
		led0 = &led0_red;
		led1 = &led0_green;
		led2 = &led0_blue;
		led0-red = &led0_red;
		led0-green = &led0_green;
		led0-blue = &led0_blue;
		pwm-led0 = &red_pwm_led;
		pwm-led1 = &green_pwm_led;
		pwm-led2 = &blue_pwm_led;
		red-pwm-led = &red_pwm_led;
		green-pwm-led = &green_pwm_led;
		blue-pwm-led = &blue_pwm_led;
		watchdog0 = &wdt0;
	};
};

&reg0 {
	status = "disabled";
};

&reg1 {
	regulator-initial-mode = <NRF5X_REG_MODE_DCDC>;
};

&radio {
	fem = <&nrf_radio_fem>;
};

&adc {
	status = "okay";
};

&gpio0 {
	status = "okay";
};

&gpio1 {
	status = "okay";
};

&gpiote {
	status = "okay";
};

&uicr {
	nfct-pins-as-gpios;
};

&pwm0 {
	status = "okay";
	pinctrl-0 = <&pwm0_default>;
	pinctrl-1 = <&pwm0_sleep>;
	pinctrl-names = "default", "sleep";
};

&ieee802154 {
	status = "okay";
};

// 新版 USB 设备栈（usbd）：src/usb.c 通过 DEVICE_DT_GET(zephyr_udc0) 取此节点。
// VID/PID 与厂商/产品串由 Kconfig 的 SLIMEVR_USB_DEVICE_* 提供（见 Kconfig / prj.conf）。
zephyr_udc0: &usbd {
	compatible = "nordic,nrf-usbd";
	status = "okay";
	cdc_acm_uart: cdc_acm_uart {
		compatible = "zephyr,cdc-acm-uart";
	};
};

&wdt {
	status = "okay";
};

&nfct {
	status = "disabled";
};
